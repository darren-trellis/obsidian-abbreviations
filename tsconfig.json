{
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2021",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "types": ["node"],
    "lib": ["DOM", "ES2022"]
  },
  "include": ["**/*.ts", "**/*.mts"]
}
